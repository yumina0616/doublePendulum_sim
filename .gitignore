*.pyc

# INFRA-003: per-run experiment output (results/raw/<run_id>/) -- generated
# data, not source. Evidence worth keeping long-term belongs under a
# specific task's tasks/<TASK-ID>/evidence/, copied there deliberately.
results/

# REFACTOR-001: generated LQR gain cache (design_lqr_gains.py output,
# keyed by plant_params.yaml's hash) -- an artifact, not source. Anyone
# who wants to run lqr_node.py needs to run design_lqr_gains.py once
# themselves (README documents this).
src/double_pendulum_control/lqr_gain_cache.json

# Netlify CLI local site-link state (site_id only, but still local
# machine state, not source -- standard netlify-cli convention)
site/.netlify/
